{
  "manifest_version": 3,
  "name": "Latchkey",
  "description": "Save a new API key to Latchkey from the page where you made it.",
  "version": "0.1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["nativeMessaging"],
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.stripe.com/*",
        "https://platform.openai.com/*",
        "https://console.anthropic.com/*",
        "https://github.com/settings/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
